{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ploos.dev/pbmp/schema/conformance-report.schema.json",
  "title": "PBMP/1 Conformance Report",
  "type": "object",
  "required": ["pbmp", "profile", "implementation", "suite", "result", "required_methods"],
  "properties": {
    "pbmp": {"const": 1},
    "profile": {"const": "M0"},
    "implementation": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "suite": {
      "type": "object",
      "required": ["revision"],
      "properties": {
        "revision": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "result": {"enum": ["pass", "fail"]},
    "required_methods": {
      "type": "object",
      "required": ["pbmp.info", "capabilities.list", "bot.info", "networks.list"],
      "properties": {
        "pbmp.info": {"enum": ["pass", "fail"]},
        "capabilities.list": {"enum": ["pass", "fail"]},
        "bot.info": {"enum": ["pass", "fail"]},
        "networks.list": {"enum": ["pass", "fail"]}
      },
      "additionalProperties": false
    },
    "capabilities_tested": {
      "type": "object",
      "additionalProperties": {"enum": ["pass", "fail", "not-tested"]}
    }
  },
  "additionalProperties": true
}
